# Track large NIfTI files with Git LFS
*.nii.gz filter=lfs diff=lfs merge=lfs -text
*.mgz filter=lfs diff=lfs merge=lfs -text
*.xfm filter=lfs diff=lfs merge=lfs -text
# Track large compressed files
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
# Track FreeSurfer files
**/freesurfer/**/*.mgz filter=lfs diff=lfs merge=lfs -text
**/freesurfer/**/*.nii.gz filter=lfs diff=lfs merge=lfs -text
# Track ANTS registration files
**/ants_fsaverage_MNI152/**/*.nii.gz filter=lfs diff=lfs merge=lfs -text
assets/ants_fsaverage_MNI152/*.nii.gz filter=lfs diff=lfs merge=lfs -text
*.ipynb filter=lfs diff=lfs merge=lfs -text
